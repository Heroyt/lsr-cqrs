{
  "name": "lsr/cqrs",
  "license": "MIT",
  "description": "Laser framework CQRS implementation.",
  "version": "0.1.4",
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.laserliga.cz"
    }
  ],
  "scripts": {
    "test": "./vendor/bin/phpunit",
    "docs": "doxygen",
    "phpstan": "./vendor/bin/phpstan",
    "cs:fix": "./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
    "cbf": "@cs:fix",
    "cs": "./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^12",
    "phpstan/phpstan": "^2.0",
    "phpstan/extension-installer": "^1.2",
    "phpstan/phpstan-nette": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "autoload": {
    "psr-4": {
      "Lsr\\CQRS\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TestCases\\": "tests/TestCases/"
    }
  },
  "authors": [
    {
      "name": "Tomáš Vojík",
      "email": "vojik@wboy.cz"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.4",
    "lsr/core": "^0.3 || ^0.4",
    "lsr/interfaces": "^0.3",
    "lsr/logging": "^0.3",
    "nette/di": "^3.2",
    "lsr/serializer": "^0.3"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "branch-alias": {
      "v0.1": "0.1.x-dev"
    }
  }
}
